{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account for authentication and role tracking",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["MASTER_OWNER", "EMPLOYEE"] },
        "status": { "type": "string", "enum": ["ativo", "inativo"] },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["uid", "email", "role", "status"]
    },
    "EmployeeProfile": {
      "title": "EmployeeProfile",
      "description": "Employee profile and granular permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string", "enum": ["ativo", "inativo"] },
        "permissions": { "type": "array" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "status", "permissions"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer and subscriber information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "cpf": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "cep": { "type": "string" },
        "street": { "type": "string" },
        "number": { "type": "string" },
        "complement": { "type": "string" },
        "neighborhood": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "reference": { "type": "string" },
        "registrationDate": { "type": "string" },
        "source": { "type": "string" },
        "employeeResponsibleId": { "type": "string" },
        "partnerId": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["ativo", "inativo", "pendente", "inadimplente"] },
        "dataConsent": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "code", "name", "cpf", "whatsapp", "status"]
    },
    "Plan": {
      "title": "Plan",
      "description": "Subscription plan definitions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "billingCycle": { "type": "string", "enum": ["mensal", "trimestral", "semestral", "anual", "personalizado"] },
        "durationMonths": { "type": "number" },
        "renewalRules": { "type": "string" },
        "terms": { "type": "string" },
        "additionalFees": { "type": "number" },
        "allowedDiscounts": { "type": "number" },
        "status": { "type": "string", "enum": ["ativo", "inativo"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "price", "billingCycle", "status"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Customer recurring subscription",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "planId": { "type": "string" },
        "startDate": { "type": "string" },
        "firstDueDate": { "type": "string" },
        "nextDueDate": { "type": "string" },
        "contractValue": { "type": "number" },
        "discountApplied": { "type": "number" },
        "billingCycle": { "type": "string" },
        "endDate": { "type": "string" },
        "autoRenew": { "type": "boolean" },
        "customRules": { "type": "string" },
        "responsibleEmployeeId": { "type": "string" },
        "status": { "type": "string", "enum": ["ativa", "cancelada", "suspensa", "finalizada"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerId", "planId", "contractValue", "billingCycle", "status"]
    },
    "Contract": {
      "title": "Contract",
      "description": "Legal contracts issued to customers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "subscriptionId": { "type": "string" },
        "templateId": { "type": "string" },
        "documentNumber": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string", "enum": ["rascunho", "emitido", "assinado", "cancelado"] },
        "issuedAt": { "type": "string" },
        "signedAt": { "type": "string" },
        "signedBy": { "type": "string" },
        "version": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerId", "documentNumber", "status"]
    },
    "ContractTemplate": {
      "title": "ContractTemplate",
      "description": "Templates for generating contracts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "templateContent": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "templateContent"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Billing and invoice statements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "subscriptionId": { "type": "string" },
        "planId": { "type": "string" },
        "amount": { "type": "number" },
        "issueDate": { "type": "string" },
        "dueDate": { "type": "string" },
        "referencePeriod": { "type": "string" },
        "description": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string", "enum": ["agendada", "pendente", "enviada", "vencida", "parcialmente_paga", "paga", "cancelada", "em_contestacao"] },
        "paidDate": { "type": "string" },
        "paidAmount": { "type": "number" },
        "transactionReference": { "type": "string" },
        "notes": { "type": "string" },
        "reminderStatus": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "invoiceNumber", "customerId", "amount", "dueDate", "status"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Confirmed payments and receipts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceId": { "type": "string" },
        "customerId": { "type": "string" },
        "amount": { "type": "number" },
        "paymentDate": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "transactionReference": { "type": "string" },
        "registeredBy": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "invoiceId", "customerId", "amount", "paymentDate"]
    },
    "Partner": {
      "title": "Partner",
      "description": "Commercial partners and affiliate referrers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "docNumber": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "commissionRuleType": { "type": "string" },
        "defaultCommissionRate": { "type": "number" },
        "defaultFixedAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["ativo", "inativo"] },
        "contactInfo": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "code", "name", "status"]
    },
    "Commission": {
      "title": "Commission",
      "description": "Calculated and paid partner commissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "partnerId": { "type": "string" },
        "invoiceId": { "type": "string" },
        "customerId": { "type": "string" },
        "eligiblePaymentAmount": { "type": "number" },
        "commissionAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["prevista", "calculada", "aprovada", "paga", "estornada"] },
        "calculationDate": { "type": "string" },
        "paidDate": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "partnerId", "commissionAmount", "status"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and activity audit records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "action": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userEmail", "action", "timestamp"]
    },
    "Setting": {
      "title": "Setting",
      "description": "System settings and secure Master Owner configurations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string" },
        "value": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "key"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User accounts"
    },
    "/employee_profiles/{profileId}": {
      "schema": "EmployeeProfile",
      "description": "Employee management and permissions"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Client registrations"
    },
    "/plans/{planId}": {
      "schema": "Plan",
      "description": "Subscription plans"
    },
    "/subscriptions/{subId}": {
      "schema": "Subscription",
      "description": "Customer active subscriptions"
    },
    "/contracts/{contractId}": {
      "schema": "Contract",
      "description": "Generated customer contracts"
    },
    "/contract_templates/{templateId}": {
      "schema": "ContractTemplate",
      "description": "Contract models and templates"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Invoices and recurring bills"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payment confirmations"
    },
    "/partners/{partnerId}": {
      "schema": "Partner",
      "description": "Affiliate and sales partners"
    },
    "/commissions/{commId}": {
      "schema": "Commission",
      "description": "Partner commissions records"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Security audit trails"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "System and Master Owner security settings"
    }
  }
}
